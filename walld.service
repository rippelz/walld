[Unit]
Description=walld — lightweight Hyprland wallpaper daemon
Documentation=file://%h/code/walld/README.md
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=%h/.local/bin/walld
Restart=on-failure
RestartSec=1
Slice=session.slice

# Prefer walld over hyprpaper for static walls.
# systemctl --user disable --now hyprpaper.service

[Install]
WantedBy=graphical-session.target
